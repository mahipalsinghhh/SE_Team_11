@startuml
title RLRS - Component Diagram (layered modular monolith)
package "Browser" {
  [Calendar UI (rlrs_app/static/app.js)] as UI
}
package "Application Process (Python stdlib http.server)" {
  [REST API + Auth\n(server.py, security.py)] as API
  [Service Layer\n(rlrs_app/service.py)] as SVC
  [Scheduling Engine\n(rlrs_core: conflict, rules)] as ENG
  [Maintenance / Attendance / Audit\n(rlrs_core)] as OPS
  [Report Engine\n(rlrs_core/report.py)] as REP
  [Background Worker Thread\n(worker_loop every 30s)] as WRK
}
database "SQLite (rlrs.db)" as DB
cloud "SMTP / FileTransport (outbox/)" as SMTP
UI --> API : HTTP / JSON
API --> SVC
SVC --> ENG
SVC --> OPS
SVC --> REP
SVC --> DB : BEGIN IMMEDIATE
WRK --> DB
WRK --> SMTP : send reminders & queued emails
@enduml
