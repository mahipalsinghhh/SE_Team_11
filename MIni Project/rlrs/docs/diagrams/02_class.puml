@startuml
title RLRS - Class Diagram (domain + engine)
enum Status {
  Pending
  Confirmed
  Cancelled
  Rejected
  Completed
  NoShow
}
enum JobStatus {
  Pending
  Sent
  Failed
  Cancelled
}
class User {
  +id : int
  +name : str
  +email : str
  +role : Student|LabInCharge|Admin
  +pw_hash : str
}
class Lab {
  +id : int
  +name : str
  +open_time : time
  +close_time : time
  +slot_minutes : int
  +max_duration : int
  +advance_days : int
  +max_active : int
}
class Equipment {
  +id : int
  +lab_id : int
  +name : str
  +type : str
  +active : bool
  +requires_approval : bool
  +remote_info : str
}
class Reservation {
  +id : int
  +user_id : int
  +equipment_id : int
  +status : Status
  +interval : Interval
  +created_at : datetime
}
class MaintenanceBlock {
  +id : int
  +equipment_id : int
  +interval : Interval
  +reason : str
}
class ReminderJob {
  +reservation_id : int
  +send_at : datetime
  +status : JobStatus
  +attempts : int
  +next_attempt_at : datetime
}
class AuditEvent {
  +actor : str
  +action : str
  +at : datetime
  +details : dict
}
class Interval << (V,#eee) >> {
  +start : datetime
  +end : datetime
  +overlaps(other : Interval) : bool
  +minutes : int
}
class SchedulingEngine {
  +find_conflicts(eq_id, interval, reservations, blocks) : Conflict[]
  +validate_booking(user_id, eq_id, interval, now, cfg, active) : Violation[]
}
class ReminderWorker {
  +plan_reminder(res, now) : ReminderJob
  +process_due(jobs, reservations, now, send) : dict
}
class ReportService {
  +utilisation_report(reservations, hours, window) : dict
}
Lab "1" o-- "*" Equipment
User "1" -- "*" Reservation : books
Equipment "1" -- "*" Reservation
Equipment "1" -- "*" MaintenanceBlock
Reservation "1" -- "0..1" ReminderJob
Reservation --> Status
ReminderJob --> JobStatus
Reservation *-- Interval
SchedulingEngine ..> Reservation
SchedulingEngine ..> MaintenanceBlock
ReminderWorker ..> ReminderJob
ReportService ..> Reservation
User "1" -- "*" AuditEvent : actor
@enduml
