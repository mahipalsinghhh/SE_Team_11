@startuml
title RLRS - Sequence: Reminder worker (RLRS-10)
participant "Worker Thread (every 30s)" as S
participant "ReminderWorker (rlrs_core/reminders.py)" as W
database "SQLite" as DB
participant "Mailer (SMTP / FileTransport)" as M
S -> W : worker_tick(now)
W -> DB : SELECT Pending reminder_jobs due <= now
loop each job
  W -> DB : load reservation
  alt cancelled / rejected / started
    W -> DB : job = Cancelled
  else active
    W -> M : send reminder
    alt success
      W -> DB : job = Sent
    else failure
      alt attempts >= 3
        W -> DB : job = Failed
      else
        W -> DB : next_attempt_at = now + backoff
      end
    end
  end
end
@enduml
